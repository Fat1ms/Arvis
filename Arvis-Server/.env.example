# Arvis Authentication Server Configuration
# Конфигурация сервера аутентификации Arvis

# Server Settings
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_RELOAD=false
SERVER_WORKERS=4

# Security
SECRET_KEY=your-secret-key-here-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database
DATABASE_URL=sqlite:///./data/auth_server.db
# For PostgreSQL: postgresql://user:password@localhost/arvis_auth
# For MySQL: mysql://user:password@localhost/arvis_auth

# CORS Settings (comma-separated allowed origins)
ALLOWED_ORIGINS=http://localhost:*,https://localhost:*
CORS_ALLOW_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Session Settings
SESSION_TIMEOUT_MINUTES=60
MAX_SESSIONS_PER_USER=5

# Login Security
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
PASSWORD_MIN_LENGTH=8

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/auth_server.log
LOG_MAX_SIZE_MB=10
LOG_BACKUP_COUNT=5

# Guest Mode
GUEST_SESSION_DURATION_MINUTES=30
GUEST_ENABLED=true

# 2FA Settings
TOTP_ISSUER=Arvis
TOTP_ENABLED=true

# Admin Account (generated on first run if not exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_PASSWORD_IMMEDIATELY
ADMIN_EMAIL=admin@arvis.local

# External APIs (server-side protected)
# OpenWeather
OPENWEATHER_API_KEY=
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
WEATHER_CACHE_TTL_MINUTES=15

# NewsAPI
NEWSAPI_API_KEY=
NEWSAPI_BASE_URL=https://newsapi.org/v2
NEWS_CACHE_TTL_MINUTES=30
