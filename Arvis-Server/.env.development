# LDS API Configuration - Development Environment

# App settings
DEBUG=true
APP_NAME=Arvis Load Distribution System
APP_VERSION=0.1.0
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql://arvis_lds:dev_password_change_in_prod@postgres:5432/arvis_lds

# Redis
REDIS_URL=redis://:dev_password_change_in_prod@redis:6379/0

# Security
USE_TLS=false
SECRET_KEY=dev-secret-key-change-in-production

# Virtual credits settings
SIGNUP_BONUS_CREDITS=1000
DAILY_BONUS_CREDITS=100

# Allowed models (comma-separated)
ALLOWED_MODELS=mistral:7b,gemma:2b,code-llama:34b

# Model costs (in virtual credits)
MODEL_COST_MISTRAL_7B=50
MODEL_COST_GEMMA_2B=20
MODEL_COST_CODE_LLAMA_34B=100

